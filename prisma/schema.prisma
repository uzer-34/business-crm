// Phase 1 foundation schema: passwordless auth, tenancy (User -> Membership ->
// Organization -> Branch), RBAC, and audit logging. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & authentication
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  // E.164 format (e.g. +14155552671). Nullable: a user may authenticate with
  // only phone or only email.
  phone     String?  @unique
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships           Membership[]
  sessions              Session[]
  auditLogs             AuditLog[]
  createdCustomers      Customer[]
  notes                 Note[]
  createdTasks          Task[]
  activities            Activity[]
  createdProducts       Product[]
  createdServices       Service[]
  inventoryMovements    InventoryMovement[]
  createdSuppliers      Supplier[]
  createdPurchaseOrders PurchaseOrder[]
  createdOrders         Order[]
  createdInvoices       Invoice[]
  recordedPayments      Payment[]
  recordedExpenses      Expense[]

  @@map("users")
}

enum OtpChannel {
  PHONE
  EMAIL
}

// A single OTP challenge. One row per code sent; never overwritten so the
// full attempt/resend history stays auditable.
model OtpChallenge {
  id          String     @id @default(cuid())
  channel     OtpChannel
  // The phone (E.164) or email address the code was sent to.
  target      String
  codeHash    String
  expiresAt   DateTime   @db.Timestamptz(3)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?  @db.Timestamptz(3)
  requestIp   String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([target, channel, createdAt])
  @@map("otp_challenges")
}

// Opaque server-side session. The cookie holds only the random token; we
// store its hash so a leaked database dump doesn't yield live sessions.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenancy: Organization -> Branch, User <-> Organization via Membership
// ---------------------------------------------------------------------------

model Organization {
  id              String   @id @default(cuid())
  name            String
  legalName       String?
  // ISO 3166-1 alpha-2 (e.g. "US", "IN", "AE").
  countryCode     String
  // ISO 4217 (e.g. "USD", "INR", "AED").
  currencyCode    String
  // IANA timezone identifier (e.g. "America/New_York", "Asia/Kolkata").
  timezone        String
  // BCP-47 locale (e.g. "en-US", "en-IN").
  locale          String
  // Industry key resolved against the code-level industry registry
  // (src/lib/industry/registry.ts). Free-form on purpose: the Industry
  // Engine (Phase 10) will move this to a richer, still additive, model.
  industryKey     String   @default("generic")
  // Atomically incremented to mint each org's own PO-0001, PO-0002, ...
  // sequence — see createPurchaseOrderForOrganization().
  poSequence      Int      @default(0)
  // Same pattern as poSequence, for Order's SO-0001, SO-0002, ... numbers.
  orderSequence   Int      @default(0)
  // Same pattern again, for Invoice's INV-0001, INV-0002, ... numbers.
  invoiceSequence Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  branches           Branch[]
  memberships        Membership[]
  roles              Role[]
  auditLogs          AuditLog[]
  customers          Customer[]
  notes              Note[]
  tasks              Task[]
  activities         Activity[]
  categories         Category[]
  products           Product[]
  services           Service[]
  inventoryMovements InventoryMovement[]
  stockLevels        StockLevel[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  orders             Order[]
  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  notifications      Notification[]
  customFieldDefinitions CustomFieldDefinition[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  // ISO 3166-1 alpha-2; defaults to the parent organization's country but can
  // differ for a branch operating cross-border.
  countryCode    String
  isDefault      Boolean      @default(false)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  membershipBranches MembershipBranch[]
  customers          Customer[]
  inventoryMovements InventoryMovement[]
  stockLevels        StockLevel[]
  purchaseOrders     PurchaseOrder[]
  orders             Order[]
  invoices           Invoice[]
  expenses           Expense[]

  @@index([organizationId])
  @@map("branches")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Links a User to an Organization with exactly one Role. Branch scope is
// explicit: allBranches=true (set for Owner/Manager by default) grants every
// branch in the org; otherwise access is limited to the linked
// MembershipBranch rows. Every tenant-scoped query must resolve the caller's
// organizationId from this table server-side — never from client input.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status         MembershipStatus @default(ACTIVE)
  allBranches    Boolean          @default(false)
  invitedAt      DateTime         @default(now()) @db.Timestamptz(3)
  joinedAt       DateTime?        @db.Timestamptz(3)

  branches          MembershipBranch[]
  assignedCustomers Customer[]
  assignedTasks     Task[]
  assignedOrders    Order[]
  notifications     Notification[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model MembershipBranch {
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@map("membership_branches")
}

// ---------------------------------------------------------------------------
// RBAC: Role and Permission are real records, not string literals in code.
// Permission is a global, code-seeded catalog shared by every organization;
// Role is per-organization so owners can add custom roles later.
// ---------------------------------------------------------------------------

model Permission {
  id          String @id @default(cuid())
  // Dot-namespaced key, e.g. "customers.view", "invoices.cancel".
  key         String @unique
  description String
  category    String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Slug unique within the org, e.g. "owner", "manager", "employee", or a
  // custom slug the owner picks for a custom role.
  key            String
  name           String
  // System roles (Owner/Manager/Employee) are seeded on org creation and
  // cannot be deleted, only have their permissions adjusted.
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  memberships Membership[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Customer 360 (brief section 17-18). Customer holds only generic fields —
// industry-specific data (vehicle info, garment size, ...) belongs in future
// per-industry modules, not here. Activity is the user-facing business
// timeline shown on a customer's page; it is intentionally separate from
// AuditLog, which is the security/compliance trail and never rendered there.
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type            CustomerType   @default(INDIVIDUAL)
  name            String
  companyName     String?
  email           String?
  phone           String?
  alternatePhone  String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  countryCode     String?
  status          CustomerStatus @default(LEAD)
  source          String?
  tags            String[]       @default([])
  assignedToId    String?
  assignedTo      Membership?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?      @db.Timestamptz(3)

  notes      Note[]
  tasks      Task[]
  activities Activity[]
  orders     Order[]
  invoices   Invoice[]

  @@index([organizationId, archivedAt])
  @@index([assignedToId])
  @@map("customers")
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorUserId   String
  author         User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@map("notes")
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title           String
  dueAt           DateTime?    @db.Timestamptz(3)
  status          TaskStatus   @default(OPEN)
  assignedToId    String?
  assignedTo      Membership?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?    @db.Timestamptz(3)

  @@index([organizationId, status, dueAt])
  @@index([assignedToId, status])
  @@map("tasks")
}

// Namespaced, subject-polymorphic so new modules can append events without a
// schema change: subjectType/subjectId identify what the event is about
// (e.g. "Customer"/<id>), type is a dot-namespaced action key.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectType    String
  subjectId      String
  type           String
  actorUserId    String?
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  // Only populated when subjectType = "Customer"; keeps a real FK (and
  // cascade delete) for the common case while subjectType/subjectId stays
  // the generic lookup path for every subject type.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, subjectType, subjectId, createdAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Catalog: Category, Product (+ variants foundation), Service (brief
// sections 19-20). Products/Services hold only generic fields — industry-
// specific attributes (vehicle compatibility, garment fabric, ...) belong in
// future per-industry modules or in ProductVariant.attributes, never as
// columns here. Inventory, suppliers, and pricing-per-branch are Phase 4/5;
// this is catalog data only.
// ---------------------------------------------------------------------------

enum CategoryKind {
  PRODUCT
  SERVICE
  EXPENSE
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           CategoryKind
  name           String
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  products Product[]
  services Service[]
  expenses Expense[]

  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, archivedAt])
  @@map("categories")
}

model Product {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name                String
  sku                 String
  barcode             String?
  brand               String?
  // Free-form unit label (e.g. "pcs", "kg", "box") — not a fixed enum since
  // units genuinely vary by industry and we don't want a migration per unit.
  unit                String       @default("pcs")
  costPrice           Decimal      @db.Decimal(12, 2)
  sellingPrice        Decimal      @db.Decimal(12, 2)
  // Flat percentage (0-100). Full tax-jurisdiction configuration is out of
  // scope until a real tax engine is needed (brief §41: don't fake it).
  taxRatePercent      Decimal      @default(0) @db.Decimal(5, 2)
  // Per-branch low-stock threshold (brief §21 "stock alerts"). Null means no
  // alerting for this product — deliberately simple, not a full alerting
  // system (no notifications, just a dashboard query).
  reorderPoint        Int?
  // Convenience default for purchase order line items — not a constraint;
  // a PO can still order this product from any supplier.
  preferredSupplierId String?
  preferredSupplier   Supplier?    @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  createdByUserId     String
  createdBy           User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt          DateTime?    @db.Timestamptz(3)

  variants           ProductVariant[]
  inventoryMovements InventoryMovement[]
  stockLevels        StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, archivedAt])
  @@map("products")
}

// The variant "foundation" the brief asks for in Phase 3: a product with no
// variants is sold directly; one with variants (e.g. Size/Color
// combinations) transacts against ProductVariant in both purchasing
// (Phase 5) and sales (Phase 6).
model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String
  // Free-form attribute set, e.g. {"size": "M", "color": "Blue"}. Deliberately
  // schemaless: which attributes matter is industry/product-specific.
  attributes   Json
  // Falls back to the parent Product's prices when null.
  costPrice    Decimal?  @db.Decimal(12, 2)
  sellingPrice Decimal?  @db.Decimal(12, 2)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  inventoryMovements InventoryMovement[]
  stockLevels        StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]

  @@unique([productId, sku])
  @@map("product_variants")
}

model Service {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  price           Decimal      @db.Decimal(12, 2)
  durationMinutes Int?
  taxRatePercent  Decimal      @default(0) @db.Decimal(5, 2)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?    @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([organizationId, archivedAt])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Inventory (brief §21): a movement ledger, not a mutable quantity column.
// StockLevel is a materialized projection of the ledger (current balance per
// branch/product/variant), kept in sync transactionally with every
// InventoryMovement insert so it never drifts from the source of truth.
//
// variantKey exists purely to work around Postgres unique-index semantics:
// NULL is never equal to NULL, so a nullable variantId can't be part of a
// real uniqueness constraint (two rows with variantId=NULL wouldn't
// conflict). variantKey is "" for a product with no variant, or the
// variant's id otherwise — always non-null, so the composite unique below
// actually enforces one balance row per (branch, product, variant).
//
// PURCHASE/SALE/RETURN exist as movement types now so the enum doesn't need
// a migration when Phase 5 (Purchasing) and Phase 6 (Sales) start creating
// them — nothing in this phase produces those types yet.
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  OPENING
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGED
  PURCHASE
  SALE
  RETURN
}

model InventoryMovement {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId            String
  branch              Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  productId           String
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId           String?
  variant             ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  variantKey          String                @default("")
  type                InventoryMovementType
  // Signed: positive = stock in, negative = stock out. The type records
  // intent (why); the sign is what actually moves the balance.
  quantityDelta       Int
  reason              String?
  // Free-text fallback for any future reference this schema doesn't have a
  // real FK for yet. PURCHASE and SALE movements use the real
  // purchaseOrderItemId/orderItemId FKs below instead of this.
  reference           String?
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem?    @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  orderItemId         String?
  orderItem           OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  // Links the two rows (TRANSFER_OUT + TRANSFER_IN) created by one transfer.
  transferGroupId     String?
  actorUserId         String
  actor               User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)

  @@index([organizationId, branchId, productId, variantKey, createdAt])
  @@index([transferGroupId])
  @@map("inventory_movements")
}

model StockLevel {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantKey     String          @default("")
  quantity       Int             @default(0)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([branchId, productId, variantKey])
  @@index([organizationId])
  @@map("stock_levels")
}

// ---------------------------------------------------------------------------
// Purchasing (brief §22): Supplier -> PurchaseOrder -> receiving -> Inventory
// -> supplier balance. Receiving has no separate "GoodsReceipt" header —
// InventoryMovement already IS the receipt record (type=PURCHASE, linked via
// purchaseOrderItemId), so a parallel ledger would just be duplication.
// Payment tracking here is deliberately a running total + status, not a
// full Payment ledger with methods/history — that's Phase 7. There is no
// DRAFT/approval workflow: a PO is live the moment it's created (brief
// §43 phases this deeper approval-style flow for Phase 11's Automobile
// Workshop module, not the generic core).
// ---------------------------------------------------------------------------

model Supplier {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  contactName     String?
  email           String?
  phone           String?
  addressLine1    String?
  city            String?
  region          String?
  postalCode      String?
  countryCode     String?
  // Tax registration number (VAT/GST/EIN/...) — free-form since the format
  // is jurisdiction-specific.
  taxId           String?
  notes           String?
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?    @db.Timestamptz(3)

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId, archivedAt])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  // Org-scoped sequential number (e.g. "PO-0001"), minted from
  // Organization.poSequence at creation — see
  // createPurchaseOrderForOrganization().
  orderNumber     String
  status          PurchaseOrderStatus @default(ORDERED)
  // Snapshots computed from items at creation time; items aren't editable
  // after creation in this phase, so these never need recomputing.
  subtotal        Decimal             @db.Decimal(12, 2)
  taxTotal        Decimal             @db.Decimal(12, 2)
  total           Decimal             @db.Decimal(12, 2)
  paymentStatus   PaymentStatus       @default(UNPAID)
  amountPaid      Decimal             @default(0) @db.Decimal(12, 2)
  notes           String?
  createdByUserId String
  createdBy       User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  items PurchaseOrderItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String          @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantityOrdered  Int
  // Cumulative — incremented by each receive action, never decremented.
  quantityReceived Int             @default(0)
  // Snapshots of the product's cost/tax at order time: prices drift, and a
  // PO should show what was actually agreed, not today's catalog price.
  unitCost         Decimal         @db.Decimal(12, 2)
  taxRatePercent   Decimal         @default(0) @db.Decimal(5, 2)

  inventoryMovements InventoryMovement[]

  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Sales (brief §23): Customer -> Order -> Order Items -> Inventory -> Payment.
// Invoices and a real Payment ledger are Phase 7 — paymentStatus here is the
// same running-total pattern as PurchaseOrder in Phase 5, not a full engine.
// Mirrors the Purchasing lifecycle deliberately: no DRAFT/quote workflow (a
// quote/estimate flow is Phase 11's Automobile Workshop module, not the
// generic core), and fulfillment is a separate step from creation, same as
// receiving is separate from ordering.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model Order {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  // Nullable: a walk-in / point-of-sale transaction doesn't require creating
  // a Customer record first.
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber     String
  status          OrderStatus   @default(PENDING)
  // Snapshots computed from items at creation time, same reasoning as
  // PurchaseOrder: items aren't editable after creation in this phase.
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(UNPAID)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  // The employee handling this sale ("employee" in brief §23's field list).
  assignedToId    String?
  assignedTo      Membership?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           String?
  createdByUserId String
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  items    OrderItem[]
  invoices Invoice[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("orders")
}

// Exactly one of productId or serviceId is set — enforced by a CHECK
// constraint added in a follow-up migration (Prisma's schema DSL can't
// express multi-column constraints) as well as by createOrderAction's
// validation. Service items never touch inventory: fulfillment just marks
// them done.
model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  serviceId         String?
  service           Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  quantityOrdered   Int
  // Cumulative — incremented by each fulfillment action, never decremented.
  quantityFulfilled Int             @default(0)
  // Snapshot of the product/service price at order time.
  unitPrice         Decimal         @db.Decimal(12, 2)
  discountPercent   Decimal         @default(0) @db.Decimal(5, 2)
  taxRatePercent    Decimal         @default(0) @db.Decimal(5, 2)

  inventoryMovements InventoryMovement[]

  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Invoices & Payments (brief §24-25). Invoice -> InvoiceItem -> Payment is
// the same ledger-plus-projection shape as InventoryMovement -> StockLevel
// in Phase 4: Payment is the append-only source of truth (never edited or
// deleted — "financial records must be auditable"), and
// Invoice.amountPaid/paymentStatus are a cached projection kept in sync
// transactionally with every Payment insert.
//
// An Invoice always derives from an existing Order (brief's own flow is
// Order -> Invoice -> Payment) rather than accepting free-form line items
// directly — standalone invoicing without a prior Order is a real gap,
// documented rather than half-built.
//
// InvoiceItem stores a plain text description instead of a Product/Service
// FK: an invoice is a financial record that must stay historically accurate
// even if the product is later renamed, re-priced, or deleted, and brief
// §24 explicitly lists "labour" alongside products/services -- a free-form
// line that was never a catalog item to begin with.
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  ISSUED
  VOID
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Denormalized from the order at generation time: an invoice must remain
  // a stable financial record even if the order's customer link changes.
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invoiceNumber   String
  status          InvoiceStatus @default(ISSUED)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  // Cached sum of this invoice's Payment rows — see the block comment above.
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?
  issuedAt        DateTime      @default(now()) @db.Timestamptz(3)
  voidedAt        DateTime?     @db.Timestamptz(3)
  createdByUserId String
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  items    InvoiceItem[]
  payments Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRatePercent  Decimal @default(0) @db.Decimal(5, 2)

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

// Append-only. Never updated or deleted after creation — a correction is a
// new Payment (or a future refund/credit type), not an edit.
model Payment {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  // Free-form: a transaction ID, cheque number, or similar, depending on
  // method — not validated against any payment gateway (brief §45: don't
  // fake a real payment integration).
  reference        String?
  recordedByUserId String
  recordedBy       User          @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@index([invoiceId, createdAt])
  @@map("payments")
}

enum ExpenseStatus {
  RECORDED
  VOID
}

// Records money going out (rent, utilities, supplies, wages paid in cash,
// etc. — brief §25). Deliberately simple: no approval workflow, no
// recurring-expense scheduling, no receipt/file upload yet (brief §41/§45:
// don't build a feature until there's a real need for it). A mistaken entry
// is voided, never deleted — same "correction, not erasure" discipline as
// Invoice, and for the same reason: financial records must stay auditable.
model Expense {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  // Who was paid — a vendor name, landlord, employee, etc. Free text: not
  // every payee is a Supplier record, and forcing one here would put the
  // Supplier module in the critical path of recording a cash expense.
  payee           String?
  // Free-form, same reasoning as Payment.reference (receipt #, cheque #).
  reference       String?
  notes           String?
  status          ExpenseStatus @default(RECORDED)
  // The date the expense was actually incurred — distinct from createdAt,
  // since expenses are often logged after the fact (e.g. entering last
  // week's receipts in a batch).
  incurredAt      DateTime      @db.Timestamptz(3)
  voidedAt        DateTime?     @db.Timestamptz(3)
  recordedByUserId String
  recordedBy      User          @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@index([organizationId, incurredAt])
  @@index([branchId, incurredAt])
  @@map("expenses")
}

enum NotificationType {
  TASK_ASSIGNED
  CUSTOMER_ASSIGNED
}

// In-app only — no email/push delivery exists yet (brief §45: don't fake a
// channel that isn't real). A row here is a real, persisted fact the
// recipient can see in the bell dropdown; it just doesn't leave the app.
model Notification {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  type           NotificationType
  message        String
  // Where clicking the notification should take the recipient, e.g.
  // "/customers/abc123". Nullable since not every notification type will
  // necessarily have one.
  linkPath       String?
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([membershipId, readAt, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Industry Engine (Phase 10) — the "generic core + industry intelligence"
// principle in schema form. Rather than adding industry-specific columns to
// Customer/Product/etc. (which would mean a migration for every vertical),
// an org can define its own fields per entity type here. Phase 11/12's
// industry packs are expected to seed sensible default definitions for their
// vertical (e.g. a workshop org getting a "Vehicle plate number" field on
// Customer automatically) rather than making the owner configure everything
// by hand — that seeding is out of scope until those phases actually exist.
// ---------------------------------------------------------------------------

// Deliberately starts with just CUSTOMER — the one entity this phase wires
// end-to-end. Add values as later phases give other entities real custom
// fields; adding an enum value is a additive, low-risk migration.
enum CustomFieldEntityType {
  CUSTOMER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomFieldDefinition {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     CustomFieldEntityType
  // Stable, URL/DB-safe key (e.g. "vehicle_plate_number"); label is what's
  // actually shown and can be edited without touching stored values.
  key            String
  label          String
  fieldType      CustomFieldType
  // Option labels for fieldType SELECT; unused (and ignored) otherwise.
  options        Json?
  required       Boolean               @default(false)
  archivedAt     DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)

  values CustomFieldValue[]

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, archivedAt])
  @@map("custom_field_definitions")
}

// Polymorphic on purpose (entityId is a free-standing id, not a real FK) —
// same "subjectId" pattern Activity already uses, since a single value table
// FK-ing to every possible entity table isn't practical in Postgres. The
// (definitionId, entityType) already scopes this to one real table via the
// definition, so the lack of a DB-level FK on entityId is an accepted
// tradeoff, not an oversight.
model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  entityId     String
  value        Json
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([definitionId, entityId])
  @@index([entityId])
  @@map("custom_field_values")
}

model AuditLog {
  id             String        @id @default(cuid())
  // Null for pre-org events (e.g. OTP requested before signup).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // Namespaced action key, e.g. "auth.otp_verified", "employee.role_changed".
  action         String
  targetType     String?
  targetId       String?
  // Never store secrets or OTP codes here.
  metadata       Json?
  ip             String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
