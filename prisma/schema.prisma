// Phase 1 foundation schema: passwordless auth, tenancy (User -> Membership ->
// Organization -> Branch), RBAC, and audit logging. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & authentication
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  // E.164 format (e.g. +14155552671). Nullable: a user may authenticate with
  // only phone or only email.
  phone     String?  @unique
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships      Membership[]
  sessions         Session[]
  auditLogs        AuditLog[]
  createdCustomers Customer[]
  notes            Note[]
  createdTasks     Task[]
  activities       Activity[]
  createdProducts  Product[]
  createdServices  Service[]

  @@map("users")
}

enum OtpChannel {
  PHONE
  EMAIL
}

// A single OTP challenge. One row per code sent; never overwritten so the
// full attempt/resend history stays auditable.
model OtpChallenge {
  id          String     @id @default(cuid())
  channel     OtpChannel
  // The phone (E.164) or email address the code was sent to.
  target      String
  codeHash    String
  expiresAt   DateTime   @db.Timestamptz(3)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?  @db.Timestamptz(3)
  requestIp   String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([target, channel, createdAt])
  @@map("otp_challenges")
}

// Opaque server-side session. The cookie holds only the random token; we
// store its hash so a leaked database dump doesn't yield live sessions.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenancy: Organization -> Branch, User <-> Organization via Membership
// ---------------------------------------------------------------------------

model Organization {
  id           String   @id @default(cuid())
  name         String
  legalName    String?
  // ISO 3166-1 alpha-2 (e.g. "US", "IN", "AE").
  countryCode  String
  // ISO 4217 (e.g. "USD", "INR", "AED").
  currencyCode String
  // IANA timezone identifier (e.g. "America/New_York", "Asia/Kolkata").
  timezone     String
  // BCP-47 locale (e.g. "en-US", "en-IN").
  locale       String
  // Industry key resolved against the code-level industry registry
  // (src/lib/industry/registry.ts). Free-form on purpose: the Industry
  // Engine (Phase 10) will move this to a richer, still additive, model.
  industryKey  String   @default("generic")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  branches    Branch[]
  memberships Membership[]
  roles       Role[]
  auditLogs   AuditLog[]
  customers   Customer[]
  notes       Note[]
  tasks       Task[]
  activities  Activity[]
  categories  Category[]
  products    Product[]
  services    Service[]

  @@map("organizations")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  // ISO 3166-1 alpha-2; defaults to the parent organization's country but can
  // differ for a branch operating cross-border.
  countryCode    String
  isDefault      Boolean      @default(false)
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  membershipBranches MembershipBranch[]
  customers          Customer[]

  @@index([organizationId])
  @@map("branches")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Links a User to an Organization with exactly one Role. Branch scope is
// explicit: allBranches=true (set for Owner/Manager by default) grants every
// branch in the org; otherwise access is limited to the linked
// MembershipBranch rows. Every tenant-scoped query must resolve the caller's
// organizationId from this table server-side — never from client input.
model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status         MembershipStatus @default(ACTIVE)
  allBranches    Boolean          @default(false)
  invitedAt      DateTime         @default(now()) @db.Timestamptz(3)
  joinedAt       DateTime?        @db.Timestamptz(3)

  branches          MembershipBranch[]
  assignedCustomers Customer[]
  assignedTasks     Task[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model MembershipBranch {
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@map("membership_branches")
}

// ---------------------------------------------------------------------------
// RBAC: Role and Permission are real records, not string literals in code.
// Permission is a global, code-seeded catalog shared by every organization;
// Role is per-organization so owners can add custom roles later.
// ---------------------------------------------------------------------------

model Permission {
  id          String @id @default(cuid())
  // Dot-namespaced key, e.g. "customers.view", "invoices.cancel".
  key         String @unique
  description String
  category    String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Slug unique within the org, e.g. "owner", "manager", "employee", or a
  // custom slug the owner picks for a custom role.
  key            String
  name           String
  // System roles (Owner/Manager/Employee) are seeded on org creation and
  // cannot be deleted, only have their permissions adjusted.
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  memberships Membership[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Customer 360 (brief section 17-18). Customer holds only generic fields —
// industry-specific data (vehicle info, garment size, ...) belongs in future
// per-industry modules, not here. Activity is the user-facing business
// timeline shown on a customer's page; it is intentionally separate from
// AuditLog, which is the security/compliance trail and never rendered there.
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

model Customer {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type            CustomerType   @default(INDIVIDUAL)
  name            String
  companyName     String?
  email           String?
  phone           String?
  alternatePhone  String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  region          String?
  postalCode      String?
  countryCode     String?
  status          CustomerStatus @default(LEAD)
  source          String?
  tags            String[]       @default([])
  assignedToId    String?
  assignedTo      Membership?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?      @db.Timestamptz(3)

  notes      Note[]
  tasks      Task[]
  activities Activity[]

  @@index([organizationId, archivedAt])
  @@index([assignedToId])
  @@map("customers")
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorUserId   String
  author         User         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  body           String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@map("notes")
}

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title           String
  dueAt           DateTime?    @db.Timestamptz(3)
  status          TaskStatus   @default(OPEN)
  assignedToId    String?
  assignedTo      Membership?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?    @db.Timestamptz(3)

  @@index([organizationId, status, dueAt])
  @@index([assignedToId, status])
  @@map("tasks")
}

// Namespaced, subject-polymorphic so new modules can append events without a
// schema change: subjectType/subjectId identify what the event is about
// (e.g. "Customer"/<id>), type is a dot-namespaced action key.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectType    String
  subjectId      String
  type           String
  actorUserId    String?
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  // Only populated when subjectType = "Customer"; keeps a real FK (and
  // cascade delete) for the common case while subjectType/subjectId stays
  // the generic lookup path for every subject type.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, subjectType, subjectId, createdAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// Catalog: Category, Product (+ variants foundation), Service (brief
// sections 19-20). Products/Services hold only generic fields — industry-
// specific attributes (vehicle compatibility, garment fabric, ...) belong in
// future per-industry modules or in ProductVariant.attributes, never as
// columns here. Inventory, suppliers, and pricing-per-branch are Phase 4/5;
// this is catalog data only.
// ---------------------------------------------------------------------------

enum CategoryKind {
  PRODUCT
  SERVICE
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           CategoryKind
  name           String
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  products Product[]
  services Service[]

  @@unique([organizationId, kind, name])
  @@index([organizationId, kind, archivedAt])
  @@map("categories")
}

model Product {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  sku             String
  barcode         String?
  brand           String?
  // Free-form unit label (e.g. "pcs", "kg", "box") — not a fixed enum since
  // units genuinely vary by industry and we don't want a migration per unit.
  unit            String       @default("pcs")
  costPrice       Decimal      @db.Decimal(12, 2)
  sellingPrice    Decimal      @db.Decimal(12, 2)
  // Flat percentage (0-100). Full tax-jurisdiction configuration is out of
  // scope until a real tax engine is needed (brief §41: don't fake it).
  taxRatePercent  Decimal      @default(0) @db.Decimal(5, 2)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?    @db.Timestamptz(3)

  variants ProductVariant[]

  @@unique([organizationId, sku])
  @@index([organizationId, archivedAt])
  @@map("products")
}

// The variant "foundation" the brief asks for in Phase 3: a product with no
// variants is sold directly; one with variants (e.g. Size/Color
// combinations) is not yet wired into inventory or sales — those come in
// Phase 4/6 and will transact against ProductVariant once they exist.
model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String
  // Free-form attribute set, e.g. {"size": "M", "color": "Blue"}. Deliberately
  // schemaless: which attributes matter is industry/product-specific.
  attributes   Json
  // Falls back to the parent Product's prices when null.
  costPrice    Decimal?  @db.Decimal(12, 2)
  sellingPrice Decimal?  @db.Decimal(12, 2)
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([productId, sku])
  @@map("product_variants")
}

model Service {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  price           Decimal      @db.Decimal(12, 2)
  durationMinutes Int?
  taxRatePercent  Decimal      @default(0) @db.Decimal(5, 2)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  archivedAt      DateTime?    @db.Timestamptz(3)

  @@index([organizationId, archivedAt])
  @@map("services")
}

model AuditLog {
  id             String        @id @default(cuid())
  // Null for pre-org events (e.g. OTP requested before signup).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  // Namespaced action key, e.g. "auth.otp_verified", "employee.role_changed".
  action         String
  targetType     String?
  targetId       String?
  // Never store secrets or OTP codes here.
  metadata       Json?
  ip             String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}
